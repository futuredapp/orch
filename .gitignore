# dependencies
node_modules/

# bun
# bun.lock is committed on purpose: CI installs with `--frozen-lockfile`
# (R-6), so the lockfile must be tracked to make dependency drift fail loud.
bun.lockb

# build output
dist/
build/
*.tsbuildinfo

# test coverage
coverage/

# orchestrator runtime state
.orchestrator/
.orch/

# example workflow artifacts (regenerated on run)
examples/riddle.txt
examples/solution.txt

# claude local overrides
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# environment
.env
.env.*

# logs
*.log
npm-debug.log*
.gstack/

# vitepress docs site
docs/public/.vitepress/cache/
docs/public/.vitepress/dist/

# tui-gallery artifacts (regenerated on demand)
artifacts/
